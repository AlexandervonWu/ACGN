import Std

namespace ACGN.Eighth.P115

/- The installed library has a finite set of admitted declaration tuples. The
   model uses character lists for the delimiter serialization in the Java map.
   The resolver and raw caller use the same map; parsing and the concrete
   declaration-to-Java-object correspondence are external to the model. -/

abbrev Text := List Char

def field (pre component : Text) : Text := pre ++ '/' :: component

def lastField (s : Text) : Text := ((s.reverse.takeWhile (· != '/')).reverse)

theorem last_field_decodes (pre component : Text) (atom : '/' ∉ component) :
    lastField (field pre component) = component := by
  have clean : ∀ c ∈ component.reverse, (c != '/') = true := by
    intro c hc
    have neq : c ≠ '/' := by
      intro eq
      subst c
      exact atom (List.mem_reverse.mp hc)
    simpa using neq
  simp [lastField, field, List.reverse_append, List.reverse_cons, List.append_assoc,
    List.takeWhile_append_of_pos clean]

theorem field_injective (p q a b : Text) (ha : '/' ∉ a) (hb : '/' ∉ b)
    (eq : field p a = field q b) : p = q ∧ a = b := by
  have decoded := congrArg lastField eq
  rw [last_field_decodes p a ha, last_field_decodes q b hb] at decoded
  subst b
  exact ⟨by simpa [field] using eq, rfl⟩

structure Key where
  moduleName : Text
  member : Text
  kind : Text
  arity : Text
  deriving DecidableEq, Repr

/-- Kind and arity are Java enum and decimal spellings respectively. -/
def AtomFields (k : Key) : Prop := '/' ∉ k.member ∧ '/' ∉ k.kind ∧ '/' ∉ k.arity

def encode (k : Key) := field (field (field k.moduleName k.member) k.kind) k.arity

theorem exact_tuple_key (a b : Key) (ha : AtomFields a) (hb : AtomFields b) :
    encode a = encode b ↔ a = b := by
  constructor
  · intro h
    obtain ⟨prefix₂, ea⟩ := field_injective _ _ _ _ ha.2.2 hb.2.2 h
    obtain ⟨prefix₁, ek⟩ := field_injective _ _ _ _ ha.2.1 hb.2.1 prefix₂
    obtain ⟨em, en⟩ := field_injective _ _ _ _ ha.1 hb.1 prefix₁
    cases a; cases b; simp_all
  · rintro rfl; rfl

/-- The cache holds the keys generated by the registered table, in arbitrary order. -/
def Lookup (table : List Key) (request : Key) : Prop :=
  AtomFields request ∧ encode request ∈ table.map encode

theorem lookup_exact (table : List Key) (registered : ∀ k ∈ table, AtomFields k) (q : Key) :
    Lookup table q ↔ q ∈ table := by
  constructor
  · rintro ⟨ok, present⟩
    obtain ⟨k, hk, same⟩ := List.mem_map.mp present
    exact ((exact_tuple_key k q (registered k hk) ok).mp same) ▸ hk
  · intro h
    exact ⟨registered q h, List.mem_map.mpr ⟨q, h, rfl⟩⟩

theorem slash_member_never_admitted (table : List Key) (q : Key) (bad : '/' ∈ q.member) :
    ¬ Lookup table q := fun h => h.1.1 bad

/-- Declaration and module identity tokens denote actual compiler objects, and
    the spelling is the parser-resolved alias/member. Arguments instantiate
    the module; the arity field on a request counts observed call arguments. -/
structure Opened where
  filename : Text
  arguments : List Text
  declarations : List Nat

structure Original where
  declaration : Nat
  spelling : Text
  kind : Text
  arity : Text
  actualArity : Text

structure Request where
  key : Key
  spelling : Text
  moduleArguments : List Text

def Owned (opens : List Opened) (r : Request) (o : Original) : Prop :=
  ∃ m ∈ opens, m.filename = r.key.moduleName ∧ m.arguments = r.moduleArguments ∧
    o.declaration ∈ m.declarations

def Admitted (table : List Key) (opens : List Opened) (r : Request) (o : Original) : Prop :=
  Lookup table r.key ∧ r.spelling = o.spelling ∧ r.key.kind = o.kind ∧
  r.key.arity = o.arity ∧ r.key.arity = o.actualArity ∧ Owned opens r o

theorem imported_admission_exact (table : List Key) (registered : ∀ k ∈ table, AtomFields k)
    (opens : List Opened) (r : Request) (o : Original) :
    Admitted table opens r o ↔ r.key ∈ table ∧ r.spelling = o.spelling ∧ r.key.kind = o.kind ∧
    r.key.arity = o.arity ∧ r.key.arity = o.actualArity ∧ Owned opens r o := by
  simp only [Admitted, lookup_exact table registered]

theorem other_pinned_overload_rejected (table : List Key) (opens : List Opened)
    (r : Request) (o : Original) (other : r.key.arity ≠ o.arity) :
    ¬ Admitted table opens r o := fun h => other h.2.2.2.1

theorem foreign_open_rejected (table : List Key) (opens : List Opened) (r : Request) (o : Original)
    (foreign : ∀ m ∈ opens, m.filename = r.key.moduleName → m.arguments = r.moduleArguments →
      o.declaration ∉ m.declarations) : ¬ Admitted table opens r o := by
  intro h
  obtain ⟨m, hm, filename, arguments, owned⟩ := h.2.2.2.2.2
  exact foreign m hm filename arguments owned

theorem same_request_preserves_original_arity_kind (table : List Key) (opens : List Opened)
    (r : Request) (o₁ o₂ : Original) (first : Admitted table opens r o₁)
    (second : Admitted table opens r o₂) : o₁.arity = o₂.arity ∧ o₁.kind = o₂.kind :=
  ⟨first.2.2.2.1.symm.trans second.2.2.2.1, first.2.2.1.symm.trans second.2.2.1⟩

