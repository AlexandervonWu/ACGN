def checked (f : Frame) : Bool :=
  Native.check f.source f.target 0 0 f.operations && decide (Native.programCost f.operations = f.cost)
set_option maxRecDepth 4096 in
set_option maxHeartbeats 2000000 in
theorem all_retained_declaration_shapes_replay : frames.all checked = true := by decide
theorem frame_replay_and_cost (frame : Frame) (member : frame ∈ frames) :
    Native.check frame.source frame.target 0 0 frame.operations = true ∧
      Native.programCost frame.operations = frame.cost := by
  have h := List.all_eq_true.mp all_retained_declaration_shapes_replay frame member
  simpa [checked] using h
