def atom0 : Nat := 0
def atom1 : Nat := 1
def atom2 : Nat := 2
def atom3 : Nat := 3
def sourceGuards : List Nat := [atom0, atom1]
def sourceBody : List (Literal Nat) := [(atom2, true), (atom3, true)]
def emittedClause : List (Literal Nat) := [(atom2, true), (atom0, false), (atom1, false), (atom3, true)]
theorem emitted_guard_clause_checked : clauseCheck sourceGuards sourceBody emittedClause = true := by decide
theorem emitted_guard_clause_sound (meaning : Nat → Prop) : ((∀ atom ∈ sourceGuards, meaning atom) → clauseEval meaning sourceBody) ↔ clauseEval meaning emittedClause := checked_clause_preserves_guard meaning _ _ _ emitted_guard_clause_checked
theorem changed_polarity_rejected : clauseCheck sourceGuards sourceBody [(atom2,true),(atom0,true),(atom1,false),(atom3,true)] = false := by decide
theorem missing_guard_rejected : clauseCheck sourceGuards sourceBody (emittedClause.erase (atom0,false)) = false := by decide
theorem extra_guard_rejected : clauseCheck sourceGuards sourceBody (emittedClause ++ [(atom0,false)]) = false := by decide

def event154Meaning {User Work Source Identifier : Type} (profile : Nat → User → Work → Prop)
    (source : Work → Source) (ids : Work → Identifier → Prop) (time : Nat) (u : User)
    (x y : Work) (atom : Nat) : Prop :=
  if atom = atom0 then profile time u x else
  if atom = atom1 then profile time u y else
  if atom = atom2 then source x ≠ source y else
  if atom = atom3 then ∀ i, ¬ (ids x i ∧ ids y i) else False

theorem event154_emitted_guard_semantics {User Work Source Identifier : Type}
    (profile : Nat → User → Work → Prop) (source : Work → Source)
    (ids : Work → Identifier → Prop) (time : Nat) (u : User) :
    StructuralDeclarationTyping.sourceAllDisjoint (profile time u)
      (fun x y => source x = source y → ∀ i, ¬ (ids x i ∧ ids y i)) ↔
    (∀ x y : Work, x ≠ y → clauseEval (event154Meaning profile source ids time u x y) emittedClause) := by
  classical
  rw [StructuralDeclarationTyping.source_guard_lowering]
  unfold StructuralDeclarationTyping.loweredAllDisjoint
  apply forall_congr'; intro x
  apply forall_congr'; intro y
  apply imp_congr_right; intro _
  have guards : (∀ atom ∈ sourceGuards, event154Meaning profile source ids time u x y atom) ↔
      profile time u x ∧ profile time u y := by
    simp [sourceGuards, event154Meaning, atom0, atom1, atom2, atom3]
  have body : (source x = source y → ∀ i, ¬ (ids x i ∧ ids y i)) ↔
      clauseEval (event154Meaning profile source ids time u x y) sourceBody := by
    by_cases equal : source x = source y <;>
      simp [clauseEval, literalEval, sourceBody, event154Meaning, atom0, atom1, atom2, atom3, equal]
  have checked := emitted_guard_clause_sound (event154Meaning profile source ids time u x y)
  constructor
  · intro h
    exact checked.mp (fun holds => body.mp (h (guards.mp holds)))
  · intro h holds
    exact body.mpr (checked.mpr h (guards.mpr holds))

