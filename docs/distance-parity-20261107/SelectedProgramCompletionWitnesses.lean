def d1Before : Mapping := fun _ => none
def d1After : Mapping := UnobservedDeclarationCompletion.extend d1Before 0 1
theorem d1_no_reads : d1Actions.all (fun a => readPair a == none) = true := by decide
theorem d1_charges : unchangedCharges d1Actions d1Before d1After = true := by decide
theorem d1_program : annotated d1Actions d1Before = annotated d1Actions d1After := checked_program_unchanged _ _ _ d1_charges
theorem d1_matrix_cost : (d1Actions.map (charge d1After)).sum = 27 := by decide
theorem d1_injective : forall x z y, d1After x = some y -> d1After z = some y -> x = z := completion_injective d1Before 0 1 (by simp [d1Before]) (by simp [d1Before])
theorem d1_old_rejected : oldAllows d1Before [] [0] [0, 1] 0 1 1 = false := by decide
def d1Source : List DeclarationReplay.Atom := [{ occurrence := 0, tuple := 0 }]
def d1Target : List DeclarationReplay.Atom := [{ occurrence := 1, tuple := 1 }, { occurrence := 2, tuple := 1 }]
def d1Edits : List DeclarationReplay.Edit := [.insert { occurrence := 1, tuple := 1 }, .pair { occurrence := 0, tuple := 0 } { occurrence := 2, tuple := 1 }]
theorem d1_declaration_replay : DeclarationReplay.replay d1Source d1Edits = some (d1Target, 2) := by decide
def d1Foreign : Binding := { (d1Bindings0[0]) with origin := { (d1Bindings0[0]).origin with owner := "foreign" } }
theorem d1_foreign_owner : associated d1Bindings0 0 d1Foreign = false := by
  apply foreign_binding_rejected d1Bindings0 0 (d1Bindings0[0]) d1Foreign rfl
  intro h
  have different := congrArg (fun b : Binding => b.origin.owner) h
  change ("foreign" : String) = "root/predicate[0]/decl[0]@pos" at different
  exact (by decide : ("foreign" : String) ≠ "root/predicate[0]/decl[0]@pos") different
def d1Read : Action := { selectedIdentity := "foreign-new-read", before := some { sourceOccurrence := "source", owner := "phase[0]", phase := 0, role := "MATRIX", branch := [], exactType := "RELATION[6:Person]", operator := "VARIABLE", binding := some 0, payload := "changed" }, after := some { sourceOccurrence := "target", owner := "phase[0]", phase := 0, role := "MATRIX", branch := [], exactType := "RELATION[6:Person]", operator := "VARIABLE", binding := some 1, payload := "changed" }, kind := "update", fixedCharge := 1 }
theorem d1_new_read_rejected : unchangedCharges [d1Read] d1Before d1After = false := by decide
def d1Linked : JointDeclarationMatrixReplay.Mapping := fun x => if x.1 = 0 then (d1After x.2).map (fun y => (0, y)) else none
theorem d1_actual_links : forall e, e ∈ ([.insert (0, 0), .keep (0, 0) (0, 1)] : List JointDeclarationMatrixReplay.Edit) -> JointDeclarationMatrixReplay.linked d1Linked e := by
  simp [JointDeclarationMatrixReplay.linked, d1Linked, d1After, d1Before, UnobservedDeclarationCompletion.extend]
