def changedPhase (w : GateWitness) : List Binding := w.current.map (fun b => { b with origin := { b.origin with phase := b.origin.phase + 1 } })
theorem all_foreign_phases_rejected : witnesses.all (fun w => !checkedSlots w.issued (changedPhase w) w.reads) = true := by decide

